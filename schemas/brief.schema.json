{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "production_id",
    "mode",
    "brand",
    "core_sentence",
    "viewer_question",
    "duration",
    "settings"
  ],
  "properties": {
    "production_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "mode": {
      "enum": [
        "production",
        "fixture"
      ]
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "settings": {
      "type": "object",
      "required": [
        "voice_model",
        "style",
        "speed",
        "shot_version",
        "asset_version",
        "caption_version",
        "render_version",
        "tool_versions"
      ]
    }
  },
  "additionalProperties": true
}
