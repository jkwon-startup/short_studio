{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "gate",
    "snapshot",
    "status",
    "reviewer",
    "checks",
    "evidence",
    "observed_video",
    "observed_audio"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_video": {
      "type": "boolean"
    },
    "observed_audio": {
      "type": "boolean"
    }
  }
}
